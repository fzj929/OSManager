[Unit]
Description=OSManager Linux host control console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
__JOURNAL_GROUP_LINE__
WorkingDirectory=__INSTALL_ROOT__/current
ExecStart=__DOTNET_BIN__ __INSTALL_ROOT__/current/OSManager.Api.dll
Restart=on-failure
RestartSec=5
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_NOLOGO=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=true
ReadWritePaths=__DATA_DIR__
TimeoutStopSec=30
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
