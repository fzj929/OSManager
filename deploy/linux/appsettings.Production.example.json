{
  "Urls": "http://0.0.0.0:5080",
  "OSManager": {
    "DataDirectory": "/var/lib/osmanager",
    "MaxUploadBytes": 104857600,
    "MaxExtractedBytes": 524288000,
    "MaxArchiveEntries": 5000,
    "LogSearchMaxDays": 7,
    "DemoMode": false,
    "ManagedDirectories": [
      {
        "Id": "app-a",
        "Name": "应用 A",
        "Path": "/opt/apps/app-a",
        "CanUpload": true,
        "RelatedService": "app-a.service"
      },
      {
        "Id": "app-a-logs",
        "Name": "应用 A 日志",
        "Path": "/var/log/app-a",
        "CanUpload": false,
        "RelatedService": "app-a.service"
      }
    ],
    "ManagedServices": [
      "app-a.service"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
