#!/usr/bin/env bash
set -Eeuo pipefail

SERVICE_USER="__SERVICE_USER__"
SERVICE_GROUP="__SERVICE_GROUP__"
DOTNET_BIN="__DOTNET_BIN__"
SYSTEMCTL_BIN="__SYSTEMCTL_BIN__"
VISUDO_BIN="__VISUDO_BIN__"
SUDOERS_DIR="/etc/sudoers.d"

fail() { echo "[ERROR] $*" >&2; exit 1; }
[[ "$(id -u)" -eq 0 ]] || fail "该助手只能由 sudo 以 root 身份执行"

validate_service() {
  [[ "$1" =~ ^[A-Za-z0-9_.@:-]+\.service$ ]] || fail "非法服务名：$1"
}

resolve_run_dir() {
  local raw_dir="$1" run_dir
  [[ "$raw_dir" == /* && "$raw_dir" =~ ^/[A-Za-z0-9._/-]+$ ]] || fail "运行目录必须是不含空格的 Linux 绝对路径"
  run_dir="$(readlink -m -- "$raw_dir")"
  case "$run_dir" in
    /|/bin|/boot|/dev|/etc|/home|/lib|/lib64|/proc|/root|/run|/sbin|/sys|/usr|/var|/opt/osmanager|/opt/osmanager/*|/var/lib/osmanager|/var/lib/osmanager/*)
      fail "拒绝使用系统或 OSManager 自身目录：$run_dir" ;;
  esac
  printf '%s\n' "$run_dir"
}

sudoers_path() {
  local safe_name="${1//[^A-Za-z0-9_-]/_}"
  printf '%s/osmanager-managed-%s\n' "$SUDOERS_DIR" "$safe_name"
}

grant_actions() {
  local service="$1" target tmp
  target="$(sudoers_path "$service")"
  tmp="$(mktemp "$SUDOERS_DIR/osmanager-managed.XXXXXX")"
  trap 'rm -f -- "${tmp:-}"' RETURN
  {
    echo "# Generated by OSManager managed-service-helper"
    echo "$SERVICE_USER ALL=(root) NOPASSWD: $SYSTEMCTL_BIN start $service, $SYSTEMCTL_BIN stop $service, $SYSTEMCTL_BIN restart $service"
  } > "$tmp"
  chmod 0440 "$tmp"
  "$VISUDO_BIN" -cf "$tmp" >/dev/null
  install -o root -g root -m 0440 "$tmp" "$target"
  rm -f -- "$tmp"
  trap - RETURN
}

register_existing() {
  local service="$1" load_state
  validate_service "$service"
  load_state="$($SYSTEMCTL_BIN show "$service" --property=LoadState --value --no-pager 2>/dev/null || true)"
  [[ "$load_state" == "loaded" ]] || fail "systemd 未加载 $service"
  grant_actions "$service"
}

prepare_directory() {
  local service="$1" run_dir
  validate_service "$service"
  run_dir="$(resolve_run_dir "$2")"
  if [[ -e "$run_dir" && ! -d "$run_dir" ]]; then fail "运行目录路径已被文件占用：$run_dir"; fi
  if [[ ! -d "$run_dir" ]]; then
    mkdir -p -- "$run_dir"
    chown "$SERVICE_USER:$SERVICE_GROUP" "$run_dir"
    chmod 0750 "$run_dir"
  fi
}

install_service() {
  local service="$1" raw_dir="$2" main_program="$3" run_dir main_path unit_path unit_tmp unit_backup="" exec_start
  validate_service "$service"
  run_dir="$(resolve_run_dir "$raw_dir")"
  [[ -d "$run_dir" ]] || fail "运行目录不存在：$run_dir"
  [[ "$main_program" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]*$ ]] || fail "主程序名称无效"
  [[ "/$main_program/" != *"/../"* && "/$main_program/" != *"/./"* ]] || fail "主程序路径不能包含 . 或 .."
  main_path="$(readlink -m -- "$run_dir/$main_program")"
  [[ "$main_path" == "$run_dir/"* && -f "$main_path" && ! -L "$main_path" ]] || fail "主程序不存在或不在运行目录中：$main_program"

  unit_path="/etc/systemd/system/$service"
  if [[ -f "$unit_path" ]] && ! grep -q '^# Managed by OSManager$' "$unit_path"; then
    fail "拒绝覆盖非 OSManager 创建的服务：$service"
  fi
  if [[ -f "$unit_path" ]]; then
    unit_backup="$(mktemp "/etc/systemd/system/$service.backup.XXXXXX")"
    cp -a -- "$unit_path" "$unit_backup"
  fi

  if [[ "$main_path" == *.dll ]]; then
    exec_start="$DOTNET_BIN $main_path"
  else
    chmod 0750 "$main_path"
    exec_start="$main_path"
  fi

  unit_tmp="$(mktemp "/etc/systemd/system/$service.XXXXXX")"
  trap 'rm -f -- "${unit_tmp:-}"' RETURN
  cat > "$unit_tmp" <<EOF
# Managed by OSManager
[Unit]
Description=Managed application $service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=$SERVICE_USER
Group=$SERVICE_GROUP
WorkingDirectory=$run_dir
ExecStart=$exec_start
Restart=on-failure
RestartSec=5
Environment=DOTNET_NOLOGO=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=$run_dir
NoNewPrivileges=true
TimeoutStopSec=30
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
EOF
  chown root:root "$unit_tmp"
  chmod 0644 "$unit_tmp"
  mv -f -- "$unit_tmp" "$unit_path"
  trap - RETURN
  "$SYSTEMCTL_BIN" daemon-reload
  grant_actions "$service"
  if ! "$SYSTEMCTL_BIN" enable --now "$service"; then
    "$SYSTEMCTL_BIN" status "$service" --no-pager -l || true
    if [[ -n "$unit_backup" ]]; then
      mv -f -- "$unit_backup" "$unit_path"
    else
      rm -f -- "$unit_path"
    fi
    rm -f -- "$(sudoers_path "$service")"
    "$SYSTEMCTL_BIN" daemon-reload || true
    if [[ -n "$unit_backup" ]]; then "$SYSTEMCTL_BIN" enable --now "$service" >/dev/null 2>&1 || true; fi
    fail "服务安装完成但启动失败：$service"
  fi
  if [[ -n "$unit_backup" ]]; then rm -f -- "$unit_backup"; fi
}

unregister_service() {
  local service="$1"
  validate_service "$service"
  rm -f -- "$(sudoers_path "$service")"
}

case "${1:-}" in
  prepare)
    [[ "$#" -eq 3 ]] || fail "用法：prepare NAME.service /run/directory"
    prepare_directory "$2" "$3" ;;
  register)
    [[ "$#" -eq 2 ]] || fail "用法：register NAME.service"
    register_existing "$2" ;;
  install)
    [[ "$#" -eq 4 ]] || fail "用法：install NAME.service /run/directory Main.dll"
    install_service "$2" "$3" "$4" ;;
  unregister)
    [[ "$#" -eq 2 ]] || fail "用法：unregister NAME.service"
    unregister_service "$2" ;;
  *) fail "不支持的操作" ;;
esac
